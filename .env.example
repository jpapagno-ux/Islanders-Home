# Islanders Home — measurement configuration
# Leave NEXT_PUBLIC_GA4_MEASUREMENT_ID empty until Stage 3 (Controlled Implementation).
# With it empty, no analytics tag loads; the data layer still renders for QA.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=https://islanders-home.vercel.app

# Content: Airtable base "The Islanders Home — Public Content". Server-side only.
# Create a read-only personal access token (scope data.records:read, this base only)
# and add it in Vercel > Project > Settings > Environment Variables. Without it the
# site serves the labelled sample content.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appJNZcT05lithwCl

# Media: Cloudinary cloud name (public).
NEXT_PUBLIC_CLOUDINARY_CLOUD=jhlnq5h5

# Private workspace (Base44) used by the Sign in and Create account links.
NEXT_PUBLIC_WORKSPACE_URL=https://vivacious-island-home-intel.base44.app
